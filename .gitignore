# --- secrets ---
.env
.env.*
!.env.example

# --- data lake (never committed; metrics/ is the only published artifact area) ---
data/

# --- local reports (Evidently HTML is ~5MB of inlined plotly) ---
reports/

# --- MLflow: local run state, never a published artifact ---
mlruns/
mlartifacts/
*.db
*.sqlite
*.sqlite3

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# mutmut's mutant cache — regenerated by `mutmut run`, never a published artifact.
.mutmut-cache
mutants/
.ipynb_checkpoints/
# uv.lock IS committed on purpose: reproducible CI runs.

# --- vercel: local project link (project id + org id), not a published artifact ---
.vercel/

# --- os / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- agent lane scratch ---
# Lane worktrees and their uv.lock copies land in the repo root as untracked
# files (~868 KB each). `git add -A` would sweep them into a commit; the parent
# directory's .gitignore does not reach inside this repo.
.lane-*
