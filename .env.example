# Copy to `.env` (gitignored) and fill in. Never commit the real file.

# EIA Open Data API v2 — free, instant, no credit card.
# Register: https://www.eia.gov/opendata/register.php
# The key arrives by email; paste it here with no quotes.
EIA_API_KEY=

# --- optional overrides (defaults in ingest/config.py) ---
# Balancing authority to model. Verified against the API's respondent facet.
# BALANCING_AUTHORITY=PJM

# Years of hourly history to pull on the first (empty-lake) run.
# HISTORY_YEARS=2

# How far back to re-pull on every run so upstream revisions overwrite ours.
# REVISION_LOOKBACK_DAYS=3

# Open-Meteo needs no key.
